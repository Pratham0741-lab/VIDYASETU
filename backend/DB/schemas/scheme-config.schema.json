{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SchemeVersionConfig",
  "description": "Canonical schema for evaluable predicate-based scholarship scheme configurations (MoTA Portal)",
  "type": "object",
  "required": [
    "rules",
    "benefits",
    "required_documents",
    "fund_sharing_ratio"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "description": "List of evaluable eligibility predicates and operational rules",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "expr",
          "params",
          "doc_refs",
          "message_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier for the rule within this scheme version"
          },
          "type": {
            "type": "string",
            "enum": [
              "eligibility",
              "benefit_note",
              "operational",
              "unmapped"
            ],
            "description": "Rule category classification"
          },
          "expr": {
            "type": "string",
            "minLength": 1,
            "description": "Predicate expression to be evaluated by the Phase 4 rules engine"
          },
          "params": {
            "type": "object",
            "description": "Key-value parameters injected into the predicate expression"
          },
          "doc_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Document types required to substantiate this rule"
          },
          "message_key": {
            "type": "string",
            "minLength": 1,
            "description": "Localization error/message key triggered when evaluation fails"
          },
          "verification": {
            "type": "object",
            "description": "Provenance and human-in-the-loop verification audit details",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["VERIFIED", "PENDING_AUDIT", "FLAGGED"]
              },
              "source_clause": {
                "type": "string"
              },
              "audited_by": {
                "type": ["string", "null"]
              },
              "audited_at": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true,
        "if": {
          "properties": {
            "type": {
              "const": "eligibility"
            }
          }
        },
        "then": {
          "required": [
            "verification"
          ],
          "properties": {
            "verification": {
              "type": "object",
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    "benefits": {
      "type": "array",
      "description": "Decomposed financial and non-financial entitlements",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount_monthly": {
            "type": [
              "number",
              "null"
            ]
          },
          "amount_annual": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "type": "string"
          },
          "duration_months": {
            "type": [
              "number",
              "null"
            ]
          },
          "disbursement_channel": {
            "type": "string"
          },
          "components": {
            "type": [
              "object",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of all mandatory and discretionary documents for the scheme version"
    },
    "fund_sharing_ratio": {
      "type": [
        "string",
        "null"
      ],
      "description": "Centre:State funding ratio e.g. 75:25, 60:40, 100:0, or null for 100% Central Sector"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "source_document": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "extraction_confidence": {
          "type": "string"
        },
        "extraction_notes": {
          "type": "string"
        },
        "data_verified": {
          "type": "boolean",
          "description": "Human verification flag: must remain false until audited against tribal.nic.in PDFs"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}