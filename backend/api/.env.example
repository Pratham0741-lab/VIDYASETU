# Environment for running the Prisma CLI and api/scripts/* from the api/
# directory (prisma migrate, prisma db seed, tsx scripts/...). Prisma loads
# api/.env automatically. Copy to api/.env and fill in. Never commit api/.env.
#
# The running api container does NOT read this file: docker compose passes
# its environment from the root ../.env (see ../.env.example).

# PostgreSQL connection. Use the migration-owner role (POSTGRES_USER), not
# app_user: migrate/seed need DDL rights app_user deliberately lacks.
# Must match POSTGRES_* in the root .env. Note: the
# compose stack does not publish Postgres to the host, so point this at a
# database you can reach from where you run the CLI.
DATABASE_URL="postgresql://vidyasetu:vidyasetu_local_pw@localhost:5432/vidyasetu?schema=public"

# AES-256-GCM key for application-layer PII encryption (Applicant
# caste_cert_number, income, bank_account): 32 random bytes, base64-encoded.
# Generate with:  npx tsx scripts/generate-pii-key.ts
# Must be identical everywhere the same database is used, or existing rows
# cannot be decrypted.
PII_ENCRYPTION_KEY=<base64-32-byte-key-from-scripts/generate-pii-key.ts>
