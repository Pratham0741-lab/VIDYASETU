  preferred_language    String
  updated_by_account_id String   @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  @@map("officer_preferences")
}

/// Phase 17 B2: consent records (insert-only; withdrawal is a new row).
model ConsentRecord {
  id                     String   @id @default(uuid()) @db.Uuid
  applicant_id           String   @db.Uuid
  purpose                String
  notice_version         String
  language               String
  status                 String // GIVEN | WITHDRAWN (DB CHECK)
  method                 String // ONLINE_FORM (DB CHECK)
  recorded_by_account_id String   @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  @@index([applicant_id, purpose, created_at(sort: Desc)], map: "consent_records_applicant_idx")
  @@map("consent_records")
}

/// Phase 17 B4: a correction request (the requested value is encrypted).
model CorrectionRequest {
  id                        String   @id @default(uuid()) @db.Uuid
  applicant_id              String   @db.Uuid
  field                     String
  requested_value_encrypted Bytes
  reason                    String
  supporting_document_id    String?  @db.Uuid
  status                    String   @default("OPEN") // OPEN | APPROVED | REJECTED
  jurisdiction_state        String
  jurisdiction_district     String?
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([applicant_id, created_at(sort: Desc)], map: "correction_requests_applicant_idx")
  @@map("correction_requests")
}

/// Phase 17 B4: insert-only decision on a correction request.
model CorrectionDecision {
  id         String   @id @default(uuid()) @db.Uuid
  request_id String   @unique(map: "correction_decisions_one_per_request_key") @db.Uuid
  officer_id String   @db.Uuid
  decision   String // APPROVE | REJECT
  reason     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("correction_decisions")
}

/// Phase 17 B5: an erasure request, recorded only.
model ErasureRequest {
  id           String   @id @default(uuid()) @db.Uuid
  applicant_id String   @db.Uuid
  status       String   @default("RECORDED")
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([applicant_id, created_at(sort: Desc)], map: "erasure_requests_applicant_idx")
  @@map("erasure_requests")
}
