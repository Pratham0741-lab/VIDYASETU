  triggered_by_account_id String?  @db.Uuid
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  @@unique([application_id, stage, stage_entered_at], map: "sla_breaches_stage_instance_key")
  @@index([detected_at], map: "sla_breaches_detected_at_idx")
  @@map("sla_breaches")
}

/// Phase 17 (E): one successful document view / download / crop view - ids,
/// route and actor only. Insert-only (the row must name the actor itself),
/// read under the jurisdiction rule; audited.
model DocumentAccessLog {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessed_at           DateTime @default(now()) @db.Timestamptz(6)
  actor_account_id      String   @db.Uuid
  actor_role            String
  access_kind           String // LIST | VIEW | CROP | DOWNLOAD (DB CHECK)
