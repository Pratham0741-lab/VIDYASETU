  resource_id           String   @db.Uuid
  application_id        String   @db.Uuid
  document_id           String?  @db.Uuid
  route                 String
  request_id            String?
  jurisdiction_state    String?
  jurisdiction_district String?

  @@index([document_id, accessed_at(sort: Desc)], map: "document_access_log_document_idx")
  @@index([application_id, accessed_at(sort: Desc)], map: "document_access_log_application_idx")
  @@index([actor_account_id, accessed_at(sort: Desc)], map: "document_access_log_actor_idx")
  @@map("document_access_log")
}

/// Phase 17 (C): one data-retention run - cutoffs and counts only, never a
