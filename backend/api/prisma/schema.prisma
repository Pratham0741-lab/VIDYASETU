  run_at                  DateTime @db.Timestamptz(6)
  policy                  Json
  counts                  Json
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([run_at(sort: Desc)], map: "retention_runs_run_at_idx")
  @@map("retention_runs")
}

/// Phase 14 loose ends (Part C): an applicant's unsubmitted application.
/// Owner-only RLS; not an application, so no queue, analytics funnel, fraud
