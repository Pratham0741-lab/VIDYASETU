{
  "name": "vidyasetu-api",
  "version": "0.1.0",
  "description": "VIDYASETU API service (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:all": "npm run test && npm run test:e2e",
    "openapi": "nest build && node dist/openapi/export-openapi.js openapi.json",
    "prisma:generate": "prisma generate",
    "validate:rules": "tsx scripts/validate-rule-params.ts",
    "test:ml": "docker compose -f ../docker-compose.yml build ml && docker build -f ../ml/Dockerfile.test -t vidyasetu-ml-test:local ../ml && docker run --rm --network none vidyasetu-ml-test:local"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "ajv": "8.20.0",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "joi": "17.13.8",
    "minio": "8.0.7",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.0.10",
    "pdfkit": "0.20.2",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!openapi/export-openapi.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
