# VIDYASETU local environment. Copy to .env:  cp .env.example .env
# Safe LOCAL defaults only. Never reuse these values outside a developer machine.
# Keep passwords URL-safe (letters, digits, - _ .): they are embedded in DATABASE_URL.
# No AI provider keys exist or are allowed: all ML runs locally in the ml service.

# ---------------------------------------------------------------- host ports (127.0.0.1)
API_HOST_PORT=3000
MAILPIT_UI_HOST_PORT=8025
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------- postgres
POSTGRES_USER=vidyasetu
POSTGRES_PASSWORD=vidyasetu_local_pw
POSTGRES_DB=vidyasetu
# Password for app_user, the non-superuser role the api connects as (set by
# the db-migrate service). Placeholder: replace with your own value
# (12-128 chars, URL-safe: letters, digits, . _ ~ -).
POSTGRES_APP_PASSWORD=CHANGE_ME_app_user_password

# ---------------------------------------------------------------- redis
REDIS_PASSWORD=vidyasetu_redis_local_pw

# ---------------------------------------------------------------- minio
# Root credentials: used only by minio itself and the minio-init container.
MINIO_ROOT_USER=vidyasetu-admin
MINIO_ROOT_PASSWORD=vidyasetu_minio_local_pw
# Least-privilege account created by minio-init; the api uses only this one.
MINIO_API_ACCESS_KEY=vidyasetu-api
MINIO_API_SECRET_KEY=vidyasetu_api_local_secret
MINIO_BUCKET_DOCUMENTS=documents

# ---------------------------------------------------------------- api
NODE_ENV=production
# fatal | error | warn | info | debug | trace | silent
API_LOG_LEVEL=info
# Comma-separated explicit origins. Wildcards are rejected at startup.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true
BODY_LIMIT=1mb
ML_TIMEOUT_MS=5000
# Document intelligence: 'mock' (default; documented fixtures, NOT real OCR) or 'real'.
ML_MODE=mock
UPLOAD_MAX_BYTES=10485760
DOC_REVIEW_THRESHOLDS={"default":0.85}
DOC_VALUE_TOLERANCE=0.05
DOC_CONSISTENCY_MIN_CONFIDENCE=0.8
# Days after a selection run during which objections are open (confirmation needs an override).
OBJECTION_WINDOW_DAYS=15
# Deficiency loop (Phase 13C): default days to fix an item (a scheme version's config may set
# deficiency_policy.deadline_days), and certificate validity in months per document type.
# The 12-month income certificate validity is an assumption awaiting confirmation.
DEFICIENCY_DEADLINE_DAYS=15
DOCUMENT_VALIDITY_MONTHS={"INCOME_CERTIFICATE":12}
# Languages applicants may choose (Phase 13D). en and hi have notification texts;
# any other falls back to English and the fallback is recorded.
SUPPORTED_LANGUAGES=en,hi,sat
# Committee approvals a provisional selection list needs before publication (Phase 13E).
SELECTION_LIST_APPROVALS_REQUIRED=1
# Phase 17: consent - the notice version applicants consent to, the purposes offered,
# and those an application requires (comma lists of purpose keys).
CONSENT_NOTICE_VERSION=2026-10-v1
CONSENT_PURPOSES=application_processing,government_verification,notifications
CONSENT_REQUIRED_PURPOSES=application_processing,government_verification
# Phase 17: data retention. The scheduled purge is off by default; when on it only
# counts (dry run) unless RETENTION_DRY_RUN=false. Days per data class, 0 = never purged.
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_INTERVAL_MS=86400000
RETENTION_NOTIFICATIONS_DAYS=365
RETENTION_REFRESH_TOKENS_DAYS=30
RETENTION_DRAFTS_DAYS=180
# Phase 14 loose ends: Aadhaar authentication adapter (mock | real; real is not configured and fails closed).
AADHAAR_MODE=mock
# Phase 14 loose ends: scheduled SLA breach sweep (BullMQ repeatable job; interval in ms).
SLA_SWEEP_ENABLED=true
SLA_SWEEP_INTERVAL_MS=900000
# Phase 14 loose ends: officer roles that may author / publish schemes (comma lists).
SCHEME_AUTHOR_ROLES=SUPER_ADMIN,MINISTRY_OFFICER
SCHEME_PUBLISHER_ROLES=SUPER_ADMIN,MINISTRY_OFFICER
# Integration adapters (Phase 10): 'mock' (default; documented in-process mocks) or 'real'
# (not configured in this build: reports unavailable, every call fails closed).
DIGILOCKER_MODE=mock
PFMS_MODE=mock
NSP_MODE=mock
# PFMS mock scenarios by application_no; unlisted applications succeed (Phase 9 behaviour).
PFMS_MOCK_SCENARIOS={}
# Fraud detection (Phase 11): HMAC key for matching identifiers without decrypting them.
# 32 random bytes, base64 - generate like the PII key; must NOT equal PII_ENCRYPTION_KEY.
FRAUD_MATCH_KEY=
FRAUD_SURGE_WINDOW_DAYS=7
FRAUD_SURGE_BASELINE_WINDOWS=8
FRAUD_SURGE_MULTIPLE=3
FRAUD_SURGE_MIN_COUNT=5
HEALTH_CHECK_TIMEOUT_MS=3000
MAIL_FROM=no-reply@vidyasetu.local
# HS256 signing key for access tokens: at least 32 random characters.
# Placeholder: replace it, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_at_least_32_chars
# Access token lifetime (seconds, 60-3600) and refresh token lifetime (seconds).
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# AES-256-GCM key for Applicant PII (32 random bytes, base64). Generate with:
#   cd api && npx tsx scripts/generate-pii-key.ts
# Replace the placeholder before `make up`; never commit a real key.
PII_ENCRYPTION_KEY=<base64-32-byte-key-from-api/scripts/generate-pii-key.ts>

# ---------------------------------------------------------------- ml
# development | production | test
ML_ENVIRONMENT=production
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ML_LOG_LEVEL=INFO